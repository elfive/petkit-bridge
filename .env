# Copy this file to `.env` and fill in the values.

# PetKit credentials — use a DEDICATED account, not your main account!
# (PetKit allows a single active session per account: sharing it causes
# the bridge to be logged out repeatedly).

PETKIT_USERNAME=${PETKIT_BRIDGE_USERNAME:-me@example.com}
PETKIT_PASSWORD=${PETKIT_BRIDGE_PASSWORD:-VeryStrongPassword}

# Region and timezone of the PetKit account
PETKIT_REGION=CN
PETKIT_TIMEZONE=Asia/Shanghai

# Static token protecting the bridge's local API.
# Generate a strong one, e.g. with: openssl rand -hex 32
BRIDGE_TOKEN=${PETKIT_BRIDGE_TOKEN:-VeryStrongToken}

# HTTP server bind
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Background refresh interval (seconds)
PETKIT_REFRESH_INTERVAL=60

# --- Resilience (optional, sensible defaults) ---
# Consecutive refresh failures before forcing a full re-login
PETKIT_RELOGIN_AFTER=3
# Cap (seconds) of the exponential backoff between retries
PETKIT_MAX_BACKOFF=300
# 1 = crash the container if the initial login fails (default 0: start in
# degraded state and let the background task keep retrying)
PETKIT_FATAL_ON_START_FAIL=0

# --- Cameras (optional) ---
# 1 = negotiate audio in camera (WHEP) sessions, 0 = video only
PETKIT_CAMERA_AUDIO=1
# Codec name sent to Agora when subscribing to the audio stream (undocumented protocol; try pcmu/opus)
PETKIT_AUDIO_SUBSCRIBE_CODEC=opus

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
